{
  "openapi": "3.1.0",
  "info": {
    "title": "Information API",
    "description": "API for retrieving and generating information from a reference database, including medical information.",
    "version": "v1.0.0"
  },
  "servers": [
    {
      "url": "https://cee9-2a01-cb05-9121-e400-697a-1def-1340-7ae1.ngrok-free.app/v1"
    }
  ],
  "paths": {
    "/ppt/generate": {
      "post": {
        "tags": ["ppt"],
        "summary": "Generate PPTX Presentation",
        "description": "Generate a PPTX slide presentation from its slide contents.",
        "operationId": "generate",
        "x-openai-isConsequential": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string",
                    "title": "Topic",
                    "description": "The topic of the presentation.",
                    "default": ""
                  },
                  "slide_titles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "title": "Slide Titles",
                    "description": "The titles of the slides.",
                    "default": []
                  },
                  "slide_contents": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "title": "Slide Contents",
                    "description": "The contents of the slides.",
                    "default": []
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/rag/query_with_links": {
      "post": {
        "summary": "Retrieve Information from Reference Database",
        "description": "Get information from the reference database about medical information.",
        "operationId": "query_with_links",
        "x-openai-isConsequential": false,
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "title": "Query",
                    "description": "The information to be looked for."
                  }
                },
                "required": ["query"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "content": {
                        "type": "string",
                        "description": "The textual content of the retrieved chunk."
                      },
                      "user_id": {
                        "type": "string",
                        "description": "The unique identifier of the user who created the file."
                      },
                      "file_id": {
                        "type": "string",
                        "description": "The unique identifier of the file where the content is stored."
                      },
                      "page": {
                        "type": "integer",
                        "description": "The page number in the file where the content is located."
                      },
                      "id": {
                        "type": "string",
                        "description": "The unique identifier of the chunk."
                      },
                      "url": {
                        "type": "string",
                        "description": "The URL link to the chunk."
                      }
                    },
                    "required": [
                      "content",
                      "user_id",
                      "file_id",
                      "page",
                      "id",
                      "url"
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  }
}
